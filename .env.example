# Option A: provide a full MongoDB connection string (credentials must be percent-encoded)
MONGODB_URI=
# You can also use the LibreChat-style variable name
# MONGO_URI=

# Option B: provide the pieces separately and the server will construct the URI safely
# MONGODB_HOST=hcux404.teagasc.net
# MONGODB_PORT=27018
# MONGODB_USERNAME=admin
# MONGODB_PASSWORD=TeagascICT2025@!
# MONGODB_AUTH_SOURCE=admin

# If your MongoDB instance is running without authentication (LibreChat's
# default docker-compose configuration), leave the username/password unset.

# Optional: override the default database name
# MONGODB_DB=LibreChat

# Port for the Express server
# PORT=3000
